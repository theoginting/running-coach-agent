# Secret that gates access to your MCP server. It becomes part of the connector
# URL: https://<your-host>/<CONNECTOR_TOKEN>/mcp — anyone with this URL can read
# your data, so use a long random value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CONNECTOR_TOKEN=""

# Strava is handled by Strava's own official MCP connector (add it separately in
# the Claude app), so no Strava credentials are needed here.

# Whoop app credentials — create an app at https://developer.whoop.com/
# Set the app's redirect URI to exactly: http://localhost:8283/callback
WHOOP_CLIENT_ID=""
WHOOP_CLIENT_SECRET=""

# Whoop tokens — generated locally by running whoop_auth.py (writes
# .whoop_tokens.json). Only set these directly for Railway deployment.
WHOOP_ACCESS_TOKEN=""
WHOOP_REFRESH_TOKEN=""
WHOOP_TOKEN_EXPIRES_AT=""

# Port for the MCP server. Railway sets $PORT automatically; default 5001 locally.
PORT=5001

# Optional: path for the persisted memory file. On Railway the filesystem is
# ephemeral, so point this at a mounted volume to keep facts across redeploys.
# MEMORY_FILE="/data/.memory.json"
